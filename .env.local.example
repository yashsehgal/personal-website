# Local Supabase (after: pnpm run supabase:start)
# Copy to .env.local — get the publishable key from: pnpm run supabase:status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GitHub OAuth for local Supabase (supabase start): put the same vars in supabase/.env
# (not only here). GitHub OAuth App callback: http://127.0.0.1:54321/auth/v1/callback
# SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
