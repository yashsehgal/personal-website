# Server-only. Never prefix these with NEXT_PUBLIC_.
#
# Local (`pnpm supabase:start`, then `pnpm dev`):
# `pnpm supabase:start` writes these into `.env.local`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
